<?xml version="1.0" encoding="utf-8"?>
<!-- Sent message bubble with neon-green gradient border and subtle glow -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Glow halo -->
    <item
        android:left="0dp"
        android:right="0dp"
        android:top="0dp"
        android:bottom="0dp">
        <shape android:shape="rectangle">
            <corners
                android:topLeftRadius="18dp"
                android:topRightRadius="4dp"
                android:bottomLeftRadius="18dp"
                android:bottomRightRadius="18dp" />
            <gradient
                android:angle="135"
                android:startColor="#2239FF14"
                android:endColor="#1100D4FF"
                android:type="linear" />
        </shape>
    </item>
    <!-- Border stroke -->
    <item
        android:left="1dp"
        android:right="1dp"
        android:top="1dp"
        android:bottom="1dp">
        <shape android:shape="rectangle">
            <corners
                android:topLeftRadius="17dp"
                android:topRightRadius="3dp"
                android:bottomLeftRadius="17dp"
                android:bottomRightRadius="17dp" />
            <gradient
                android:angle="135"
                android:startColor="#1B3022"
                android:endColor="#102015"
                android:type="linear" />
        </shape>
    </item>
</layer-list>
