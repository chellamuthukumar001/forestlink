<?xml version="1.0" encoding="utf-8"?>
<!-- Received message bubble with cyber-blue gradient border -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Glow halo -->
    <item
        android:left="0dp"
        android:right="0dp"
        android:top="0dp"
        android:bottom="0dp">
        <shape android:shape="rectangle">
            <corners
                android:topLeftRadius="4dp"
                android:topRightRadius="18dp"
                android:bottomLeftRadius="18dp"
                android:bottomRightRadius="18dp" />
            <gradient
                android:angle="135"
                android:startColor="#1A00D4FF"
                android:endColor="#1239FF14"
                android:type="linear" />
        </shape>
    </item>
    <!-- Border stroke -->
    <item
        android:left="1dp"
        android:right="1dp"
        android:top="1dp"
        android:bottom="1dp">
        <shape android:shape="rectangle">
            <corners
                android:topLeftRadius="3dp"
                android:topRightRadius="17dp"
                android:bottomLeftRadius="17dp"
                android:bottomRightRadius="17dp" />
            <gradient
                android:angle="135"
                android:startColor="#1E2522"
                android:endColor="#141A18"
                android:type="linear" />
        </shape>
    </item>
</layer-list>
