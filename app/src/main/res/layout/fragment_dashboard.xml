<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/transparent">

    <!-- Header Section -->
    <LinearLayout
        android:id="@+id/layout_header"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="24dp"
        android:layout_marginTop="28dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/text_dashboard_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="COMMAND CENTER"
                android:textColor="@color/text_primary"
                android:textSize="22sp"
                android:textStyle="bold"
                android:letterSpacing="0.06" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="TACTICAL MESH • 433MHZ"
                android:textColor="@color/cyber_blue"
                android:textSize="11sp"
                android:textStyle="bold"
                android:letterSpacing="0.12" />
        </LinearLayout>

        <!-- Live Status Pill Indicator -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/card_elevated"
            android:backgroundTint="#CC111F17"
            android:paddingHorizontal="10dp"
            android:paddingVertical="5dp">

            <View
                android:layout_width="7dp"
                android:layout_height="7dp"
                android:background="@drawable/shape_circle_pulse"
                android:backgroundTint="@color/neon_green" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:text="ACTIVE"
                android:textColor="@color/canopy_lime"
                android:textSize="10sp"
                android:textStyle="bold"
                android:letterSpacing="0.08" />
        </LinearLayout>

    </LinearLayout>

    <!-- Bento Status Cards Container -->
    <LinearLayout
        android:id="@+id/layout_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="24dp"
        android:layout_marginTop="20dp"
        android:orientation="horizontal"
        app:layout_constraintTop_toBottomOf="@id/layout_header">

        <!-- Signal Bento Card -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_signal_status"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="6dp"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground"
            app:cardBackgroundColor="#CC111F17"
            app:cardCornerRadius="14dp"
            app:strokeColor="@color/glass_border"
            app:strokeWidth="1dp">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="12dp"
                android:gravity="center">
                <ImageView
                    android:id="@+id/img_signal"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:src="@drawable/ic_signal"
                    app:tint="@color/text_secondary" />
                <TextView
                    android:id="@+id/text_connection_status"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="OFFLINE"
                    android:textColor="@color/text_secondary"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:fontFamily="sans-serif-medium" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Battery Bento Card -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_battery_status"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginHorizontal="3dp"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground"
            app:cardBackgroundColor="#CC111F17"
            app:cardCornerRadius="14dp"
            app:strokeColor="@color/glass_border"
            app:strokeWidth="1dp">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="12dp"
                android:gravity="center">
                <ImageView
                    android:id="@+id/img_battery"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:src="@drawable/ic_battery"
                    app:tint="@color/text_secondary" />
                <TextView
                    android:id="@+id/text_battery"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="--%"
                    android:textColor="@color/text_secondary"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:fontFamily="sans-serif-medium" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- GPS Bento Card -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_gps_status"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="6dp"
            android:clickable="true"
            android:focusable="true"
            android:foreground="?attr/selectableItemBackground"
            app:cardBackgroundColor="#CC111F17"
            app:cardCornerRadius="14dp"
            app:strokeColor="@color/glass_border_cyan"
            app:strokeWidth="1dp">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="12dp"
                android:gravity="center">
                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:src="@android:drawable/ic_menu_mylocation"
                    app:tint="@color/text_secondary" />
                <TextView
                    android:id="@+id/text_gps_summary"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="NO FIX"
                    android:textColor="@color/text_secondary"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:fontFamily="sans-serif-medium" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>

    <!-- Mesh Visualization Bento Card -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/card_mesh"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginHorizontal="24dp"
        android:layout_marginVertical="18dp"
        app:cardBackgroundColor="#CC111F17"
        app:cardCornerRadius="16dp"
        app:strokeColor="@color/glass_border"
        app:strokeWidth="1dp"
        app:layout_constraintBottom_toTopOf="@id/btn_sos_container"
        app:layout_constraintTop_toBottomOf="@id/layout_status">
        
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="16dp">

            <TextView
                android:id="@+id/text_mesh_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="NETWORK MESH STATUS"
                android:textColor="@color/text_secondary"
                android:textSize="10sp"
                android:letterSpacing="0.16"
                android:textStyle="bold"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:id="@+id/text_routing_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="SEARCHING FOR NODES..."
                android:textColor="@color/neon_green"
                android:textSize="13sp"
                android:textStyle="bold"
                android:letterSpacing="0.04"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/text_mesh_label" />

            <!-- AI Telemetry & Health Subtitle -->
            <LinearLayout
                android:id="@+id/layout_ai_indicators"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:orientation="horizontal"
                app:layout_constraintTop_toBottomOf="@id/text_routing_status">

                <TextView
                    android:id="@+id/text_ai_reliability"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="AI LINK: --"
                    android:textColor="@color/cyber_blue"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/text_node_health"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="HEALTH: HEALTHY"
                    android:textColor="@color/canopy_lime"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Active Anomaly Alert Banner -->
            <LinearLayout
                android:id="@+id/layout_anomaly_alert"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:background="#33EF4444"
                android:padding="6dp"
                android:visibility="gone"
                android:orientation="horizontal"
                app:layout_constraintTop_toBottomOf="@id/layout_ai_indicators">

                <TextView
                    android:id="@+id/text_anomaly_banner"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="⚠️ ANOMALY: NO ACTIVE ALERTS"
                    android:textColor="@color/pulse_red"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <com.forest.offgrid.ui.dashboard.RadarSweepView
                android:id="@+id/img_mesh_visual"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_marginTop="12dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/layout_anomaly_alert" />

        </androidx.constraintlayout.widget.ConstraintLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- SOS Emergency Section -->
    <FrameLayout
        android:id="@+id/btn_sos_container"
        android:layout_width="190dp"
        android:layout_height="190dp"
        android:layout_marginBottom="24dp"
        app:layout_constraintBottom_toTopOf="@id/layout_quick_actions"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <!-- Outer Pulse View (animated in code) -->
        <View
            android:id="@+id/sos_pulse_outer"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/shape_circle_pulse"
            android:alpha="0" />

        <View
            android:id="@+id/sos_pulse_inner"
            android:layout_width="150dp"
            android:layout_height="150dp"
            android:layout_gravity="center"
            android:background="@drawable/shape_circle_pulse"
            android:alpha="0" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_sos"
            android:layout_width="114dp"
            android:layout_height="114dp"
            android:layout_gravity="center"
            android:backgroundTint="@color/pulse_red"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:text="SOS"
            android:textColor="@color/white"
            android:textSize="24sp"
            android:textStyle="bold"
            android:letterSpacing="0.04"
            app:cornerRadius="57dp"
            app:elevation="8dp" />
    </FrameLayout>

    <!-- Quick Actions -->
    <LinearLayout
        android:id="@+id/layout_quick_actions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="24dp"
        android:layout_marginBottom="28dp"
        android:orientation="horizontal"
        app:layout_constraintBottom_toBottomOf="parent">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_quick_text"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:text="SEND SECURE MESSAGE"
            android:textColor="@color/text_primary"
            android:textStyle="bold"
            android:letterSpacing="0.06"
            app:backgroundTint="#CC111F17"
            app:cornerRadius="16dp"
            app:strokeWidth="1.5dp"
            app:strokeColor="@color/neon_green" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>

