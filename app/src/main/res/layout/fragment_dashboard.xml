<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/forest_dark">

    <!-- Header Section -->
    <TextView
        android:id="@+id/text_dashboard_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="24dp"
        android:layout_marginTop="32dp"
        android:text="COMMAND CENTER"
        android:textColor="@color/cyber_blue"
        android:textSize="24sp"
        android:textStyle="bold"
        android:letterSpacing="0.1"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Simulation Switch Removed -->

    <!-- Status Cards Container -->
    <LinearLayout
        android:id="@+id/layout_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="24dp"
        android:layout_marginTop="24dp"
        android:orientation="horizontal"
        app:layout_constraintTop_toBottomOf="@id/text_dashboard_title">

        <com.google.android.material.card.MaterialCardView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="8dp"
            app:cardBackgroundColor="#1A141E1A"
            app:cardCornerRadius="12dp"
            app:strokeColor="#26FFFFFF"
            app:strokeWidth="1dp">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="12dp"
                android:gravity="center">
                <ImageView
                    android:id="@+id/img_signal"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_signal"
                    app:tint="@color/text_secondary" />
                <TextView
                    android:id="@+id/text_connection_status"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="OFFLINE"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp"
                    android:fontFamily="monospace" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginHorizontal="4dp"
            app:cardBackgroundColor="#1A141E1A"
            app:cardCornerRadius="12dp"
            app:strokeColor="#26FFFFFF"
            app:strokeWidth="1dp">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="12dp"
                android:gravity="center">
                <ImageView
                    android:id="@+id/img_battery"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_battery"
                    app:tint="@color/text_secondary" />
                <TextView
                    android:id="@+id/text_battery"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="--%"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp"
                    android:fontFamily="monospace" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            app:cardBackgroundColor="#1A141E1A"
            app:cardCornerRadius="12dp"
            app:strokeColor="#26FFFFFF"
            app:strokeWidth="1dp">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="12dp"
                android:gravity="center">
                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@android:drawable/ic_menu_mylocation"
                    app:tint="@color/text_secondary" />
                <TextView
                    android:id="@+id/text_gps_summary"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="NO FIX"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp"
                    android:fontFamily="monospace" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>

    <!-- Mesh Visualization Area -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/card_mesh"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginHorizontal="24dp"
        android:layout_marginVertical="24dp"
        app:cardBackgroundColor="#2A141E1A"
        app:cardCornerRadius="16dp"
        app:strokeColor="@color/cyber_blue"
        app:strokeWidth="1dp"
        app:layout_constraintBottom_toTopOf="@id/btn_sos_container"
        app:layout_constraintTop_toBottomOf="@id/layout_status">
        
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="16dp">

            <TextView
                android:id="@+id/text_mesh_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="NETWORK MESH STATUS"
                android:textColor="@color/text_secondary"
                android:textSize="10sp"
                android:letterSpacing="0.2"
                android:fontFamily="monospace"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:id="@+id/text_routing_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="SEARCHING FOR NODES..."
                android:textColor="@color/neon_green"
                android:textSize="14sp"
                android:fontFamily="monospace"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/text_mesh_label" />

            <!-- AI Telemetry & Health Subtitle -->
            <LinearLayout
                android:id="@+id/layout_ai_indicators"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:orientation="horizontal"
                app:layout_constraintTop_toBottomOf="@id/text_routing_status">

                <TextView
                    android:id="@+id/text_ai_reliability"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="AI LINK: --"
                    android:textColor="@color/cyber_blue"
                    android:textSize="11sp"
                    android:fontFamily="monospace" />

                <TextView
                    android:id="@+id/text_node_health"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="HEALTH: HEALTHY"
                    android:textColor="@color/neon_green"
                    android:textSize="11sp"
                    android:fontFamily="monospace" />
            </LinearLayout>

            <!-- Active Anomaly Alert Banner -->
            <LinearLayout
                android:id="@+id/layout_anomaly_alert"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:background="#33FF1744"
                android:padding="6dp"
                android:visibility="gone"
                android:orientation="horizontal"
                app:layout_constraintTop_toBottomOf="@id/layout_ai_indicators">

                <TextView
                    android:id="@+id/text_anomaly_banner"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="⚠️ ANOMALY: NO ACTIVE ALERTS"
                    android:textColor="@color/pulse_red"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:fontFamily="monospace" />
            </LinearLayout>

            <com.forest.offgrid.ui.dashboard.RadarSweepView
                android:id="@+id/img_mesh_visual"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_marginTop="16dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/layout_anomaly_alert" />

        </androidx.constraintlayout.widget.ConstraintLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- SOS Section -->
    <FrameLayout
        android:id="@+id/btn_sos_container"
        android:layout_width="200dp"
        android:layout_height="200dp"
        android:layout_marginBottom="40dp"
        app:layout_constraintBottom_toTopOf="@id/layout_quick_actions"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <!-- Outer Pulse View (animated in code) -->
        <View
            android:id="@+id/sos_pulse_outer"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/shape_circle_pulse"
            android:alpha="0" />

        <View
            android:id="@+id/sos_pulse_inner"
            android:layout_width="160dp"
            android:layout_height="160dp"
            android:layout_gravity="center"
            android:background="@drawable/shape_circle_pulse"
            android:alpha="0" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_sos"
            android:layout_width="120dp"
            android:layout_height="120dp"
            android:layout_gravity="center"
            android:backgroundTint="@color/pulse_red"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:text="SOS"
            android:textColor="@color/white"
            android:textSize="24sp"
            android:textStyle="bold"
            app:cornerRadius="60dp"
            app:elevation="8dp" />
    </FrameLayout>

    <!-- Quick Actions -->
    <LinearLayout
        android:id="@+id/layout_quick_actions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="24dp"
        android:layout_marginBottom="32dp"
        android:orientation="horizontal"
        app:layout_constraintBottom_toBottomOf="parent">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_quick_text"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:text="SEND MESSAGE"
            android:textColor="@color/white"
            app:cornerRadius="12dp"
            app:strokeColor="@color/cyber_blue" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
