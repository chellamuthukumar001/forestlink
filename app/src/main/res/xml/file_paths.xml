<?xml version="1.0" encoding="utf-8"?>
<paths xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- External files directory for camera photos -->
    <external-files-path
        name="photos"
        path="Pictures/" />
    <!-- Internal files for media (voice/image) storage -->
    <files-path
        name="media"
        path="media/" />
    <!-- Cache directory for temporary compressed files -->
    <cache-path
        name="cache"
        path="." />
</paths>
