<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/navigation_landing">

    <!-- Landing Page -->
    <fragment
        android:id="@+id/navigation_landing"
        android:name="com.forest.offgrid.ui.landing.LandingFragment"
        android:label="ForestLink"
        tools:layout="@layout/fragment_landing">
        <action
            android:id="@+id/action_landing_to_dashboard"
            app:destination="@id/navigation_dashboard"
            app:enterAnim="@anim/dashboard_enter_scale"
            app:exitAnim="@anim/landing_exit_scale"
            app:popEnterAnim="@anim/dashboard_enter_scale"
            app:popExitAnim="@anim/landing_exit_scale"
            app:popUpTo="@id/navigation_landing"
            app:popUpToInclusive="true" />
        <action
            android:id="@+id/action_landing_to_devices"
            app:destination="@id/navigation_devices"
            app:enterAnim="@anim/dashboard_enter_scale"
            app:exitAnim="@anim/landing_exit_scale"
            app:popEnterAnim="@anim/dashboard_enter_scale"
            app:popExitAnim="@anim/landing_exit_scale"
            app:popUpTo="@id/navigation_landing"
            app:popUpToInclusive="true" />
    </fragment>


    <fragment
        android:id="@+id/navigation_dashboard"
        android:name="com.forest.offgrid.ui.dashboard.DashboardFragment"
        android:label="Dashboard"
        tools:layout="@layout/fragment_dashboard" />

    <fragment
        android:id="@+id/navigation_chat"
        android:name="com.forest.offgrid.ui.chat.ChatFragment"
        android:label="Chat"
        tools:layout="@layout/fragment_chat" />

    <fragment
        android:id="@+id/navigation_map"
        android:name="com.forest.offgrid.ui.map.MapFragment"
        android:label="Map"
        tools:layout="@layout/fragment_map" />

    <fragment
        android:id="@+id/navigation_devices"
        android:name="com.forest.offgrid.ui.devices.DevicesFragment"
        android:label="Devices"
        tools:layout="@layout/fragment_devices" />

    <fragment
        android:id="@+id/navigation_settings"
        android:name="com.forest.offgrid.ui.settings.SettingsFragment"
        android:label="Settings"
        tools:layout="@layout/fragment_settings" />
</navigation>
